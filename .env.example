# Copy this file to .env and insert your API keys.
# Never commit .env to source control.

OPENAI_API_KEY=
JEV_API_KEY=

# Defaults can be changed without editing source code.
OPENAI_MODEL=gpt-5.1
JEV_MODEL=jev-latest

# Optional Jev override. HTTPS is required; HTTP and redirects are rejected.
# Leave blank for automatic routing:
#   jv_live_... key -> https://jevtypesafeai.com/api/v1/decide
#   other TypeSafe key -> https://api.typesafe.ai/v1/systemone
JEV_API_URL=

# The Streamlit app fixes its path to data/techmedic_v1_5_6.sqlcipher.
# TECHMEDIC_DB_PATH applies only to other callers of get_settings(), not this UI.

# TechMedic v1.5 controlled web/documentation research.
# Uses the existing OPENAI_API_KEY; no additional search API key is required.
TECHMEDIC_WEB_RESEARCH_ENABLED=true
TECHMEDIC_WEB_RESEARCH_MAX_SOURCES=10
